# 이 파일을 복사해 이름을 .env 로 바꾸고, = 뒤에 값을 넣으세요(따옴표 없이). .env 는 남에게 보내지 마세요.
# 바꾼 뒤에는 서버(run_server.bat)를 껐다 켜야 적용됩니다.

# 외부 주소(Tailscale Funnel)에서 실험 실행·데이터 가져오기·추가·삭제를 할 때 넣는 암호. 길게(12자 이상) 정하세요.
TSP_WRITE_PASSWORD=

# 데이터 출처 접속 키
FRED_API_KEY=
ECOS_API_KEY=
DATAGO_API_KEY=
KRX_ID=
KRX_PW=

# 코드 따라가기 음성 녹음(narrate.bat)에만 필요
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
